# 現在のブランチ名を取得
current_branch=$(git rev-parse --abbrev-ref HEAD)

# develop/mainブランチの場合はチェックを除外（Git Flow対応）
if [ "$current_branch" = "develop" ] || [ "$current_branch" = "main" ]; then
  echo "Info: Special branch '$current_branch' - skipping sync check"
  exit 0
fi

git fetch origin main 2>/dev/null || true
git fetch origin develop 2>/dev/null || true
if [ -n "$(git log HEAD..origin/main --oneline 2>/dev/null)" ]; then
  echo ; echo "🚨🚨🚨 Merge the latest main branch before pushing 🚨🚨🚨" ; echo
  exit 1
fi

if git rev-parse --verify origin/develop > /dev/null 2>&1; then
  if [ -n "$(git log HEAD..origin/develop --oneline 2>/dev/null)" ]; then
    echo ; echo "🚨🚨🚨 Merge the latest develop branch before pushing 🚨🚨🚨" ; echo
    exit 1
  fi
fi
